# Telematics provider API credentials. Fill in whichever applies to your fleet.

# Samsara (https://developers.samsara.com)
SAMSARA_API_TOKEN=

# Geotab MyGeotab (https://developers.geotab.com)
GEOTAB_DATABASE=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=

# Motive, formerly KeepTruckin (https://developer.gomotive.com)
MOTIVE_API_TOKEN=

# Verizon Connect Reveal
VERIZON_CONNECT_USERNAME=
VERIZON_CONNECT_PASSWORD=

# Optional persistence for ZoneTracker state and ZoneEvent history
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:pass@localhost:5432/fleet

# Optional alerting sinks
SLACK_WEBHOOK_URL=
KAFKA_BROKERS=
